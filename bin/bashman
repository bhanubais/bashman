#!/usr/bin/env bash
# bashman: Stateless API Client CLI
set -eou pipefail

VERSION="0.1.0"

# Determine script root directory
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# shellcheck source=../lib/doctor.sh
source "$ROOT_DIR/lib/doctor.sh"
# shellcheck source=../lib/interpolator.sh
source "$ROOT_DIR/lib/interpolator.sh"
# shellcheck source=../lib/http_parser.sh
source "$ROOT_DIR/lib/http_parser.sh"
# shellcheck source=../lib/dispatcher.sh
source "$ROOT_DIR/lib/dispatcher.sh"

show_help() {
  cat <<'EOF'
bashman - Stateless API Client & Network Request Orchestrator

Usage:
  bashman [command] [options] <arguments>

Commands:
  run <file.http>      Execute the single-request .http file
  doctor               Inspect toolchain dependencies and report engine tier

Options:
  --env <name>         Load cascading environment (.env.<name>)
  --dry-run            Parse and display the prepared request without dispatching
  -h, --help           Show this help manual
  -v, --version        Show current version

EOF
}

show_version() {
  printf "bashman v%s\n" "$VERSION"
}

# Main CLI Router
if [[ $# -eq 0 ]]; then
  show_help
  exit 0
fi

case "$1" in
  -h|--help)
    show_help
    exit 0
    ;;
  -v|--version)
    show_version
    exit 0
    ;;
  doctor)
    run_doctor
    exit $?
    ;;
  run)
    shift
    ENV_NAME=""
    DRY_RUN=0
    TARGET_FILE=""

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --env)
          if [[ -z "${2:-}" ]]; then
            printf "[bashman] error: --env requires an environment name argument\n" >&2
            exit 2
          fi
          ENV_NAME="$2"
          shift 2
          ;;
        --dry-run)
          DRY_RUN=1
          shift
          ;;
        -*)
          printf "[bashman] error: Unknown option '%s'\n" "$1" >&2
          exit 2
          ;;
        *)
          if [[ -z "$TARGET_FILE" ]]; then
            TARGET_FILE="$1"
          else
            printf "[bashman] error: Multiple request files specified ('%s' and '%s'). Only single-request files supported.\n" "$TARGET_FILE" "$1" >&2
            exit 2
          fi
          shift
          ;;
      esac
    done

    if [[ -z "$TARGET_FILE" ]]; then
      printf "[bashman] error: missing target .http file\n" >&2
      printf "Usage: bashman run [--env <name>] [--dry-run] <file.http>\n" >&2
      exit 2
    fi

    if [[ ! -f "$TARGET_FILE" ]]; then
      printf "[bashman] error: request file '%s' not found\n" "$TARGET_FILE" >&2
      exit 1
    fi

    # 1. Load cascading environment from file directory or working directory
    file_dir="$(cd "$(dirname "$TARGET_FILE")" && pwd)"
    load_environment "$file_dir" "$ENV_NAME"

    # 2. Parse single-request .http file
    parse_http_file "$TARGET_FILE"

    # 3. Interpolate variables into URL, headers, and body
    PARSED_URL=$(interpolate_template "$PARSED_URL")
    if [[ "${#PARSED_HEADERS[@]}" -gt 0 ]]; then
      for idx in "${!PARSED_HEADERS[@]}"; do
        PARSED_HEADERS[idx]=$(interpolate_template "${PARSED_HEADERS[idx]}")
      done
    fi
    if [[ -n "$PARSED_BODY" ]]; then
      PARSED_BODY=$(interpolate_template "$PARSED_BODY")
    fi

    # 4. Dry-run or Network Dispatch
    if [[ "$DRY_RUN" -eq 1 ]]; then
      execute_dry_run "$PARSED_METHOD" "$PARSED_URL" PARSED_HEADERS "$PARSED_BODY"
      exit 0
    fi

    dispatch_request "$PARSED_METHOD" "$PARSED_URL" PARSED_HEADERS "$PARSED_BODY"
    exit 0
    ;;
  -*)
    printf "[bashman] error: Unknown option '%s'\n" "$1" >&2
    show_help >&2
    exit 2
    ;;
  *)
    printf "[bashman] error: Unknown command '%s'\n" "$1" >&2
    show_help >&2
    exit 2
    ;;
esac
